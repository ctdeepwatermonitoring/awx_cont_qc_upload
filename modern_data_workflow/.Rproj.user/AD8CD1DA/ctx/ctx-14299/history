SQL = 'SELECT * FROM temperature WHERE staSeq == ? AND strftime(\'%Y\', mDate) == ?;'
for (i in 1:nrow(unique_combos)) {
unique_site = unique_combos[i, "staSeq"]
unique_year = unique_combos[i, "distinct_year"]
