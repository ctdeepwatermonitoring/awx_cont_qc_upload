# Establishing database connection
con <- dbConnect(SQLite(), dbname = 'historic_temperature.db')
SQL = 'SELECT DISTINCT staSeq, strftime(\'%Y\', mDate) AS distinct_year FROM temperature;'
unique_combos = dbGetQuery(conn = con, SQL)
SQL = 'SELECT * FROM temperature WHERE staSeq == ? AND strftime(\'%Y\', mDate) == ?;'
for (i in 1:nrow(unique_combos)) {
unique_site = unique_combos[i, "staSeq"]
unique_year = unique_combos[i, "distinct_year"]
data_by_site_year = dbGetQuery(conn = con, SQL, params = c(unique_site, unique_year))
data_by_site_year$mDateTime <- as.POSIXct(paste(data_by_site_year$mDate, data_by_site_year$mTime), format="%Y-%m-%d %H:%M:%S")
file_name = paste0(unique_site, "_Water_", unique_year, "0101_", unique_year, "1231.csv")
file_directory = paste0("/home/deepuser/Documents/historic_temperature_project/testing_csvs/", file_name)
write.csv(data_by_site_year, file_directory)
print(paste("Processed", i, "of", nrow(unique_combos), "files"))
}
