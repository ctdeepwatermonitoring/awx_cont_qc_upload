#Function requires input and output directories to be specified.
#Other parameters have defaults but can be changed:
#Converts from .heic by default
#Converts to .jpg by default
#Keeps the files that were converted from by default
convert_files = function(input_directory, output_directory, convert_from = "heic", convert_to = "jpg", keep_old_files = TRUE) {
  pattern = paste0(" *.", convert_from)
  old_files = list.files(path = input_directory, pattern = pattern)
  
  for (image in old_files) {
    input_path = paste0(input_directory, image)
    image_name_no_ext = tools::file_path_sans_ext(image)
    output_filename = paste0(image_name_no_ext, ".", convert_to)
    output_path = paste0(output_directory, output_filename)
    
    current_image = image_read(input_path)
    current_image_convert = image_convert(current_image, convert_to)
    
    image_write(current_image_convert, path = output_path)
    
    if (!keep_old_files) {
      file.remove(input_path)
    }
  }
}

