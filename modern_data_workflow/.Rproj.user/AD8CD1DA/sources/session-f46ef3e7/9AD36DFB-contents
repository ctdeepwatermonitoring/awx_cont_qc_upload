# Loading RSQLite library
library(RSQLite) 

# Establishing database connection
con <- dbConnect(SQLite(), dbname = 'historic_temperature.db')

# Creating a query (selecting all data from the temperature table from before 1999)
SQL <- 'SELECT * FROM temperature where mDate < "1999-01-01";'

# Query results
data_1998 <- dbGetQuery(conn = con, SQL)
